                      "&[data-state='active']": {
                        borderBottom: "none",
                        "& > div": {
                          bg: "gray.100",
                          borderColor: "gray.300",
                        }
                      },
                      "&[data-state='inactive']": {
                        borderBottom: "none",
                      }
                    }}
                  >
                    <Box
                      bg="gray.100"
                      border="1px solid"
                      borderColor="gray.300"
                      borderRadius="md"
                      px="4"
                      py="2"
                    >
