              border="1px solid"
              borderColor="gray.200"
              height="100%"
            >
              <Tabs.Root value={activeTab} onValueChange={(e) => setActiveTab(e.value)}>
                <Tabs.List
                  display="flex"
                  gap="2"
                  mb="4"
                  borderBottom="none"
                >
                  <Tabs.Trigger 
                    value="products"
                    css={{
